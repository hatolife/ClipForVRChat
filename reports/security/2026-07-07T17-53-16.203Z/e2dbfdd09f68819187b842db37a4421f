func (w *AutoPhotoWatcher) tick() {
	current := scanPhotoFiles(w.Config.AutoPhoto.PhotoDirectory)
	processed := 0
	for _, path := range sortedPhotoPaths(current) {
		modTime := current[path]
		if _, ok := w.seen[path]; ok {
